NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://toryteler:toryteler@localhost:5434/toryteler

# Firma las cookies de sesión. Mínimo 32 caracteres; cambiarla cierra la sesión
# de todo el mundo. En producción, generarla con `openssl rand -hex 32`.
SESSION_SECRET=cambiar-por-una-cadena-de-32-caracteres-o-mas

# A dónde vuelve el comprador desde la pasarela, y de dónde se aceptan
# peticiones del navegador (CORS).
PUBLIC_WEB_URL=http://localhost:3001

# Opcional. A dónde devuelve Wompi tras pagar; tiene que ser https y público,
# nunca localhost. Sin definirla se usa PUBLIC_WEB_URL, y si esa es localhost
# el parámetro se omite: el pago liquida igual por el webhook.
# PAYMENT_RETURN_URL=https://un-tunel-publico.trycloudflare.com

# Wompi · dashboard → Desarrolladores. Las cuatro son distintas en sandbox y en
# producción, y la de eventos hay que copiarla al configurar el webhook.
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
# El checkout tiene que ser del mismo entorno que las llaves. Con llaves
# pub_stagtest_ el de producción responde 403: no las conoce.
#   UAT/sandbox  https://checkout.co.uat.wompi.dev/p/
#   producción   https://checkout.wompi.co/p/
WOMPI_CHECKOUT_URL=https://checkout.co.uat.wompi.dev/p/

# Cloudinary · guarda las fotos de las piezas y los contratos en PDF. La URL
# completa la da el dashboard e incluye clave y secreto.
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Cloudflare Stream · guarda los videos efímeros.
#   ACCOUNT_ID     dashboard → Stream, o la URL: dash.cloudflare.com/<esto>/stream
#   TOKEN          token de API con permiso Stream:Edit, no la clave global
#   CUSTOMER_CODE  el <CODE> de customer-<CODE>.cloudflarestream.com, visible en
#                  la pestaña Settings de cualquier video
CF_STREAM_ACCOUNT_ID=xxx
CF_STREAM_TOKEN=xxx
CF_STREAM_CUSTOMER_CODE=xxx

# Resend · correos. Mientras termine en "xxx" no se manda nada: el correo se
# escribe entero en la consola, que es como se recorre el flujo en local.
RESEND_API_KEY=re_xxx
# Remitente. Tiene que ser un dominio verificado en Resend; el de por defecto
# solo entrega al correo dueño de la cuenta.
MAIL_FROM=Toryteler <onboarding@resend.dev>
# A dónde responde quien reciba el correo. Esta sí puede ser cualquier
# dirección, incluido un Gmail: solo el remitente exige dominio verificado.
MAIL_REPLY_TO=tu-correo@ejemplo.com

# Quién vende, tal como saldrá impreso en el contrato de compraventa. Sin esto
# el contrato no identifica a una de las partes.
SELLER_NAME=Nombre legal del artista
SELLER_DOCUMENT=C.C. 1.234.567.890
SELLER_EMAIL=hola@toryteler.co
SELLER_CITY=Medellín
